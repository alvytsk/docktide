{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-connection-status",
    "allow-subscribe-live-updates",
    "allow-list-containers",
    "allow-get-container",
    "allow-start-container",
    "allow-stop-container",
    "allow-restart-container"
  ]
}
