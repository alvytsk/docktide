{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-connection-status",
    "allow-subscribe-live-updates",
    "allow-subscribe-stats",
    "allow-list-containers",
    "allow-get-container",
    "allow-start-container",
    "allow-stop-container",
    "allow-restart-container",
    "allow-list-images",
    "allow-get-image",
    "allow-remove-image",
    "allow-get-build-cache-usage",
    "allow-prune-build-cache",
    "allow-open-logs",
    "allow-close-logs"
  ]
}
